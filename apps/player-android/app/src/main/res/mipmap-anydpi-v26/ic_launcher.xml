<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon. Android and OEM launchers own the mask and any
     parallax. The mark is generated from branding/source/tilecast-mark.svg by
     branding/generate-launcher-assets.mjs. The separate monochrome layer
     keeps TEST lettering visible when Android applies a themed tint. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/tilecast_signal_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
